{
  "name": "falcon-optimizer",
  "version": "2.0.0",
  "description": "Windows gaming optimizer focused on minimum input latency and maximum FPS.",
  "main": "main.js",
  "author": "Eli",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/catalog.test.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "portable": "electron-builder --win portable"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.falconoptimizer.app",
    "productName": "Falcon Optimizer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "app/**",
      "catalog/**",
      "src/**",
      "scripts/**",
      "data/**",
      "assets/**",
      "tools/**"
    ],
    "asar": true,
    "asarUnpack": [
      "scripts/**",
      "data/**",
      "assets/**",
      "tools/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "raptoraimoffical-cloud",
        "repo": "FalconOptimizerPremium",
        "releaseType": "release"
      }
    ],
    "portable": {
      "artifactName": "FalconOptimizer-${version}-portable.exe"
    }
  },
  "productName": "Falcon Optimizer",
  "allowScripts": {
    "electron@45.2.1": true
  }
}
