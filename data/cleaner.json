{
  "notes": "Speed Boost cleaner targets. paths: env vars expanded, * wildcards allowed, {steam} = Steam install folder. Only caches/logs/leftovers that apps rebuild on their own. Deliberately NOT included: Prefetch (deleting it slows app launches), Telegram tdata (that is your login and chats, not a cache), event logs (needed for troubleshooting), Office file cache (can hold unsynced uploads).",
  "groups": ["Windows", "Graphics", "Browsers", "Game launchers & games", "Apps", "Privacy"],
  "targets": [
    { "id": "user_temp", "group": "Windows", "name": "Your temp folder", "paths": ["%TEMP%"], "default": true },
    { "id": "win_temp", "group": "Windows", "name": "Windows temp folder", "paths": ["%WINDIR%\\Temp"], "default": true },
    { "id": "wu_download", "group": "Windows", "name": "Windows Update download cache", "paths": ["%WINDIR%\\SoftwareDistribution\\Download"], "default": true, "note": "Already-installed update packages." },
    { "id": "delivery_opt", "group": "Windows", "name": "Delivery Optimization cache", "paths": ["%WINDIR%\\ServiceProfiles\\NetworkService\\AppData\\Local\\Microsoft\\Windows\\DeliveryOptimization\\Cache", "%ProgramData%\\Microsoft\\Windows\\DeliveryOptimization\\Cache"], "default": true },
    { "id": "upgrade_leftovers", "group": "Windows", "name": "Windows upgrade leftovers", "paths": ["%SystemDrive%\\$WINDOWS.~BT", "%SystemDrive%\\$WINDOWS.~WS", "%SystemDrive%\\$GetCurrent"], "default": true },
    { "id": "crash_dumps", "group": "Windows", "name": "Crash dumps", "paths": ["%LOCALAPPDATA%\\CrashDumps", "%WINDIR%\\Minidump", "%WINDIR%\\MEMORY.DMP", "%WINDIR%\\LiveKernelReports"], "default": true },
    { "id": "error_reports", "group": "Windows", "name": "Windows Error Reporting files", "paths": ["%ProgramData%\\Microsoft\\Windows\\WER\\ReportArchive", "%ProgramData%\\Microsoft\\Windows\\WER\\ReportQueue", "%LOCALAPPDATA%\\Microsoft\\Windows\\WER"], "default": true },
    { "id": "setup_logs", "group": "Windows", "name": "Windows setup & servicing logs", "paths": ["%WINDIR%\\Logs\\CBS", "%WINDIR%\\Logs\\DISM", "%WINDIR%\\Logs\\MoSetup", "%WINDIR%\\Panther"], "default": true, "note": "Files Windows is currently writing are skipped." },
    { "id": "thumbnails", "group": "Windows", "name": "Thumbnail & icon cache", "paths": ["%LOCALAPPDATA%\\Microsoft\\Windows\\Explorer\\thumbcache_*.db", "%LOCALAPPDATA%\\Microsoft\\Windows\\Explorer\\iconcache_*.db"], "default": true, "note": "Rebuilt automatically; files Explorer has open are skipped." },
    { "id": "store_cache", "group": "Windows", "name": "Microsoft Store & Store-app temp files", "paths": ["%LOCALAPPDATA%\\Packages\\Microsoft.WindowsStore_*\\LocalCache", "%LOCALAPPDATA%\\Packages\\*\\AC\\Temp", "%LOCALAPPDATA%\\Packages\\*\\AC\\INetCache"], "default": true },
    { "id": "recycle_bin", "group": "Windows", "name": "Recycle Bin", "special": "recyclebin", "default": true },

    { "id": "dx_shader", "group": "Graphics", "name": "DirectX shader cache", "paths": ["%LOCALAPPDATA%\\D3DSCache"], "default": false, "note": "Games recompile shaders on next launch (brief stutter). Best after a driver update." },
    { "id": "gpu_vendor_shader", "group": "Graphics", "name": "NVIDIA / AMD / Intel shader caches", "paths": ["%LOCALAPPDATA%\\NVIDIA\\DXCache", "%LOCALAPPDATA%\\NVIDIA\\GLCache", "%ProgramData%\\NVIDIA Corporation\\NV_Cache", "%LOCALAPPDATA%\\AMD\\DxCache", "%LOCALAPPDATA%\\AMD\\DxcCache", "%LOCALAPPDATA%\\AMD\\VkCache", "%LOCALAPPDATA%\\AMD\\GLCache", "%LOCALAPPDATA%Low\\Intel\\ShaderCache"], "default": false, "note": "Same as above: only after a driver update or if a game stutters after patching." },
    { "id": "driver_installers", "group": "Graphics", "name": "Extracted driver installers", "paths": ["%SystemDrive%\\NVIDIA", "%SystemDrive%\\AMD", "%SystemDrive%\\Intel\\GFX", "%ProgramData%\\NVIDIA Corporation\\Downloader"], "default": true, "note": "Setup files left behind after installing GPU drivers." },
    { "id": "gpu_app_logs", "group": "Graphics", "name": "NVIDIA App / AMD Software logs & web cache", "paths": ["%LOCALAPPDATA%\\NVIDIA Corporation\\NVIDIA App\\CefCache", "%ProgramData%\\NVIDIA Corporation\\NVIDIA App\\Logs", "%ProgramData%\\NVIDIA Corporation\\GeForce Experience\\Logs", "%LOCALAPPDATA%\\AMD\\CN\\logs", "%LOCALAPPDATA%\\AMD\\CN\\CefCache"], "default": true },

    { "id": "chrome", "group": "Browsers", "name": "Google Chrome cache", "paths": ["%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\Cache", "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\Code Cache", "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\GPUCache", "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\Crashpad\\reports"], "default": true, "note": "Cache only — passwords, cookies and history are kept." },
    { "id": "edge", "group": "Browsers", "name": "Microsoft Edge cache", "paths": ["%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\*\\Cache", "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\*\\Code Cache", "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\*\\GPUCache"], "default": true, "note": "Cache only — passwords, cookies and history are kept." },
    { "id": "brave", "group": "Browsers", "name": "Brave cache", "paths": ["%LOCALAPPDATA%\\BraveSoftware\\Brave-Browser\\User Data\\*\\Cache", "%LOCALAPPDATA%\\BraveSoftware\\Brave-Browser\\User Data\\*\\Code Cache", "%LOCALAPPDATA%\\BraveSoftware\\Brave-Browser\\User Data\\*\\GPUCache"], "default": true },
    { "id": "opera", "group": "Browsers", "name": "Opera / Opera GX cache", "paths": ["%LOCALAPPDATA%\\Opera Software\\Opera Stable\\Cache", "%LOCALAPPDATA%\\Opera Software\\Opera GX Stable\\Cache", "%APPDATA%\\Opera Software\\Opera GX Stable\\Code Cache", "%APPDATA%\\Opera Software\\Opera Stable\\Code Cache"], "default": true },
    { "id": "firefox", "group": "Browsers", "name": "Firefox cache", "paths": ["%LOCALAPPDATA%\\Mozilla\\Firefox\\Profiles\\*\\cache2"], "default": true },

    { "id": "steam", "group": "Game launchers & games", "name": "Steam web cache, logs & dumps", "paths": ["{steam}\\appcache\\httpcache", "{steam}\\logs", "{steam}\\dumps", "%LOCALAPPDATA%\\Steam\\htmlcache"], "default": true, "note": "Your games and Steam shader pre-caches are not touched." },
    { "id": "epic", "group": "Game launchers & games", "name": "Epic Games Launcher cache & logs", "paths": ["%LOCALAPPDATA%\\EpicGamesLauncher\\Saved\\webcache*", "%LOCALAPPDATA%\\EpicGamesLauncher\\Saved\\Logs"], "default": true },
    { "id": "battlenet", "group": "Game launchers & games", "name": "Battle.net cache & logs", "paths": ["%ProgramData%\\Battle.net\\Cache", "%LOCALAPPDATA%\\Battle.net\\Cache", "%LOCALAPPDATA%\\Battle.net\\BrowserCache", "%LOCALAPPDATA%\\Battle.net\\Logs"], "default": true },
    { "id": "riot", "group": "Game launchers & games", "name": "Riot Client & VALORANT logs", "paths": ["%LOCALAPPDATA%\\Riot Games\\Riot Client\\Logs", "%LOCALAPPDATA%\\VALORANT\\Saved\\Logs", "%LOCALAPPDATA%\\VALORANT\\Saved\\Crashes"], "default": true },
    { "id": "ue_games", "group": "Game launchers & games", "name": "Unreal Engine game logs & crash reports", "paths": ["%LOCALAPPDATA%\\FortniteGame\\Saved\\Logs", "%LOCALAPPDATA%\\FortniteGame\\Saved\\Crashes", "%LOCALAPPDATA%\\CrashReportClient", "%LOCALAPPDATA%\\UnrealEngine\\Common\\DerivedDataCache"], "default": true },
    { "id": "minecraft", "group": "Game launchers & games", "name": "Minecraft logs & crash reports", "paths": ["%APPDATA%\\.minecraft\\logs", "%APPDATA%\\.minecraft\\crash-reports"], "default": true },
    { "id": "roblox", "group": "Game launchers & games", "name": "Roblox logs & cache", "paths": ["%LOCALAPPDATA%\\Roblox\\logs", "%LOCALAPPDATA%\\Roblox\\Downloads"], "default": true },

    { "id": "discord", "group": "Apps", "name": "Discord cache", "paths": ["%APPDATA%\\discord\\Cache", "%APPDATA%\\discord\\Code Cache", "%APPDATA%\\discord\\GPUCache", "%APPDATA%\\discordptb\\Cache", "%APPDATA%\\discordcanary\\Cache"], "default": true, "note": "Close Discord first for the best result — files it has open are skipped." },
    { "id": "spotify", "group": "Apps", "name": "Spotify streaming cache", "paths": ["%LOCALAPPDATA%\\Spotify\\Data"], "default": true, "note": "Downloaded songs are kept." },
    { "id": "adobe", "group": "Apps", "name": "Adobe media cache", "paths": ["%APPDATA%\\Adobe\\Common\\Media Cache Files", "%APPDATA%\\Adobe\\Common\\Media Cache"], "default": true },
    { "id": "onedrive_logs", "group": "Apps", "name": "OneDrive logs", "paths": ["%LOCALAPPDATA%\\Microsoft\\OneDrive\\logs"], "default": true },

    { "id": "recent", "group": "Privacy", "name": "Recent files & Quick Access history", "paths": ["%APPDATA%\\Microsoft\\Windows\\Recent\\*.lnk", "%APPDATA%\\Microsoft\\Windows\\Recent\\AutomaticDestinations", "%APPDATA%\\Microsoft\\Windows\\Recent\\CustomDestinations"], "default": false, "note": "Clears jump lists and recent-file history (privacy, not speed)." }
  ]
}
