{
  "items": [
    {
      "id": "power_device_wake_list",
      "type": "button",
      "name": "Wake Devices: List Programmable + Armed",
      "risk": "Safe",
      "riskLevel": "Safe",
      "category": "Power Management",
      "description": "Shows devices that can wake and devices currently armed for wake events.",
      "apply": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "powercfg /devicequery wake_programmable"
          },
          {
            "type": "cmd.run",
            "command": "powercfg /devicequery wake_armed"
          }
        ]
      }
    },
    {
      "id": "power_device_wake_disable_mouse",
      "type": "button",
      "name": "Wake Devices: Disable Wake for HID-compliant mouse",
      "risk": "Safe",
      "riskLevel": "Safe",
      "category": "Power Management",
      "requiresAdmin": true,
      "description": "Disables mouse wake source to reduce accidental desk wake events.",
      "apply": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "powercfg /devicedisablewake \"HID-compliant mouse\""
          }
        ]
      }
    },
    {
      "id": "power_device_wake_disable_keyboard",
      "type": "button",
      "name": "Wake Devices: Disable Wake for HID Keyboard Device",
      "risk": "Warning",
      "riskLevel": "Warning",
      "category": "Power Management",
      "requiresAdmin": true,
      "description": "Disables keyboard wake source; re-enable manually if needed.",
      "apply": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "powercfg /devicedisablewake \"HID Keyboard Device\""
          }
        ]
      },
      "revert": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "powercfg /deviceenablewake \"HID Keyboard Device\""
          }
        ]
      }
    },
    {
      "id": "power_device_wake_enable_keyboard",
      "type": "button",
      "name": "Wake Devices: Enable Wake for HID Keyboard Device",
      "risk": "Safe",
      "riskLevel": "Safe",
      "category": "Power Management",
      "requiresAdmin": true,
      "description": "Re-enables keyboard wake if you disabled it previously.",
      "apply": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "powercfg /deviceenablewake \"HID Keyboard Device\""
          },
          {
            "type": "cmd.run",
            "command": "powercfg /devicequery wake_armed"
          }
        ]
      }
    },
    {
      "id": "power_device_wake_enable_mouse",
      "type": "button",
      "name": "Wake Devices: Enable Wake for HID-compliant mouse",
      "risk": "Safe",
      "riskLevel": "Safe",
      "category": "Power Management",
      "requiresAdmin": true,
      "description": "Re-enables mouse wake if you disabled it previously.",
      "apply": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "powercfg /deviceenablewake \"HID-compliant mouse\""
          },
          {
            "type": "cmd.run",
            "command": "powercfg /devicequery wake_armed"
          }
        ]
      }
    }
  ]
}
