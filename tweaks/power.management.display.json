          }
        ]
      }
    },
    {
      "id": "power_display_off_never_split",
      "type": "button",
      "name": "Display Off Timeout: Never (AC/DC)",
      "risk": "Warning",
      "riskLevel": "Warning",
      "category": "Power Management",
      "requiresAdmin": true,
      "description": "Keeps displays active indefinitely on both power sources.",
