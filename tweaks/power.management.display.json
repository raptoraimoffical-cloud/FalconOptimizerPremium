{
  "items": [
    {
      "id": "power_display_idle_acdc",
      "type": "button",
      "name": "Display: Idle Timeout 15m (AC) / 5m (DC)",
      "risk": "Safe",
      "riskLevel": "Safe",
      "category": "Power Management",
      "requiresAdmin": true,
      "description": "Controls display-off timeout separately by power source.",
      "apply": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "powercfg -setacvalueindex SCHEME_CURRENT SUB_VIDEO VIDEOIDLE 15"
          },
          {
            "type": "cmd.run",
            "command": "powercfg -setdcvalueindex SCHEME_CURRENT SUB_VIDEO VIDEOIDLE 5"
          },
          {
            "type": "cmd.run",
            "command": "powercfg /setactive SCHEME_CURRENT"
          }
        ]
      }
    },
    {
      "id": "power_display_dim_timeout",
      "type": "button",
      "name": "Display: Dim Timeout 10m (AC) / 3m (DC)",
      "risk": "Safe",
      "riskLevel": "Safe",
      "category": "Power Management",
      "requiresAdmin": true,
      "description": "Sets dim timeout separately from display-off timeout.",
      "apply": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "powercfg -setacvalueindex SCHEME_CURRENT SUB_VIDEO VIDEODIM 10"
          },
          {
            "type": "cmd.run",
            "command": "powercfg -setdcvalueindex SCHEME_CURRENT SUB_VIDEO VIDEODIM 3"
          },
          {
            "type": "cmd.run",
            "command": "powercfg /setactive SCHEME_CURRENT"
          }
        ]
      }
    },
    {
