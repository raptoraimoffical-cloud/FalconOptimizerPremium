{
  "items": [
    {
      "id": "power_energy_saver_threshold",
      "type": "button",
      "name": "Energy Saver: Start at 20% Battery",
      "risk": "Safe",
      "riskLevel": "Safe",
      "category": "Power Management",
      "requiresAdmin": true,
      "description": "Configures Battery Saver trigger threshold where supported.",
      "apply": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "powercfg -setdcvalueindex SCHEME_CURRENT SUB_ENERGYSAVER ESBATTTHRESHOLD 20"
          },
          {
            "type": "cmd.run",
            "command": "powercfg /setactive SCHEME_CURRENT"
          }
        ]
      }
    },
    {
      "id": "power_energy_saver_brightness",
      "type": "button",
      "name": "Energy Saver: Brightness Reduction 30%",
      "risk": "Safe",
      "riskLevel": "Safe",
      "category": "Power Management",
      "requiresAdmin": true,
      "description": "Sets Energy Saver display brightness reduction level.",
      "apply": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "powercfg -setdcvalueindex SCHEME_CURRENT SUB_ENERGYSAVER ESBRIGHTNESS 30"
          },
          {
            "type": "cmd.run",
            "command": "powercfg /setactive SCHEME_CURRENT"
          }
        ]
      }
    },
    {
      "id": "power_energy_saver_disable_ac_enable_dc",
      "type": "button",
      "name": "Energy Saver: Off on AC / On on DC",
      "risk": "Safe",
      "riskLevel": "Safe",
      "category": "Power Management",
      "requiresAdmin": true,
      "description": "Applies AC/DC split for energy saver behavior.",
      "apply": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "powercfg -setacvalueindex SCHEME_CURRENT SUB_ENERGYSAVER ESBATTTHRESHOLD 0"
          },
          {
            "type": "cmd.run",
            "command": "powercfg -setdcvalueindex SCHEME_CURRENT SUB_ENERGYSAVER ESBATTTHRESHOLD 40"
          },
          {
            "type": "cmd.run",
            "command": "powercfg /setactive SCHEME_CURRENT"
          }
        ]
      }
    }
  ]
}
