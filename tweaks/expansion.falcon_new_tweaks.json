      "id": "falcon_new_wer_queue_cleaner",
      "type": "action",
      "name": "Telemetry: WER Queue Cleaner",
      "description": "Deletes local WER report queue/cache files to reclaim disk and reduce stale crash junk.",
      "category": "Telemetry",
      "riskLevel": "Safe",
      "requiresAdmin": true,
      "primaryLabel": "Clean",
      "apply": {
        "steps": [
          {
            "type": "ps.run",
            "command": "$paths=@(\"$env:ProgramData\\Microsoft\\Windows\\WER\\ReportQueue\",\"$env:ProgramData\\Microsoft\\Windows\\WER\\ReportArchive\",\"$env:LOCALAPPDATA\\Microsoft\\Windows\\WER\"); foreach($p in $paths){ if(Test-Path $p){ Remove-Item -Path $p -Recurse -Force -ErrorAction SilentlyContinue } }; Write-Output \"WER queues cleaned.\""
          }
        ]
      },
      "revert": {
        "steps": []
      }
