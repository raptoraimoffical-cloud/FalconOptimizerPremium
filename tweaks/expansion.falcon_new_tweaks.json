{
  "items": [
    {
      "id": "falcon_new_disable_reserved_storage",
      "type": "toggle",
      "name": "Storage: Disable Reserved Storage",
      "description": "Disables Windows Reserved Storage allocation to recover disk space and trim background reservation behavior.",
      "category": "Storage",
      "riskLevel": "Warning",
      "requiresAdmin": true,
      "apply": {
        "steps": [
          {
            "type": "registry.set",
            "path": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\ReserveManager",
            "name": "ShippedWithReserves",
            "value": 0,
            "valueType": "DWord"
          }
        ]
      },
      "revert": {
        "steps": [
          {
            "type": "registry.remove",
            "path": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\ReserveManager",
            "name": "ShippedWithReserves"
          }
        ]
      },
      "check": {
        "steps": [
          {
            "type": "registry.check",
            "path": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\ReserveManager",
            "name": "ShippedWithReserves",
            "valueType": "DWord",
            "equals": 0
          }
        ]
      }
    },
