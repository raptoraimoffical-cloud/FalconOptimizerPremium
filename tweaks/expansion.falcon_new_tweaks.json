    {
      "id": "falcon_new_disable_sata_link_power_mgmt",
      "type": "toggle",
      "name": "Storage Latency: Disable SATA Link Power Management",
      "description": "Applies an AC-power latency-focused preset for AHCI link power management.",
      "category": "Storage Latency",
      "riskLevel": "Warning",
      "requiresAdmin": true,
      "apply": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "powercfg /SETACVALUEINDEX SCHEME_CURRENT SUB_DISK DAB60367-53FE-4FBC-825E-521D069D2456 0"
          },
          {
            "type": "cmd.run",
            "command": "powercfg /SETACTIVE SCHEME_CURRENT"
          }
        ]
      },
      "revert": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "powercfg /SETACVALUEINDEX SCHEME_CURRENT SUB_DISK DAB60367-53FE-4FBC-825E-521D069D2456 1"
          },
          {
            "type": "cmd.run",
            "command": "powercfg /SETACTIVE SCHEME_CURRENT"
          }
        ]
      }
    },
