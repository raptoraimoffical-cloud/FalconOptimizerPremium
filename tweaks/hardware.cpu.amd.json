{
  "items": [
    {
      "id": "cpu.amd.cppc_awareness_check",
      "name": "AMD CPPC / Preferred Cores Awareness",
      "category": "Hardware / CPU (AMD)",
      "risk": "Safe",
      "riskLevel": "Safe",
      "type": "button",
      "description": "Detects CPPC/preferred cores capability exposure and reports support state. BIOS/firmware-aware check only; no blind registry writes.",
      "applicability": {
        "cpuVendors": [
          "amd"
        ],
        "requiresAdmin": false
      },
      "badges": [
        "AMD_ONLY",
        "REQUIRES_BIOS_SUPPORT"
      ],
      "apply": {
        "steps": [
          {
            "type": "ps.run",
            "command": "$c=(powercfg /qh SCHEME_CURRENT SUB_PROCESSOR 75b0ae3f-bce0-45a7-8c89-c9611c25e100 2>$null | Out-String); if([string]::IsNullOrWhiteSpace($c)){ Write-Output 'CPPC preferred cores: unsupported/not exposed'; exit 0 } else { Write-Output 'CPPC preferred cores: exposed'; exit 0 }"
          }
        ]
      }
    },
    {
      "id": "cpu.amd.disable_basic_cstates",
      "name": "AMD Idle Policy - Safe Gaming (AC)",
      "category": "Hardware / CPU (AMD)",
      "risk": "Warning",
      "riskLevel": "Warning",
      "type": "toggle",
      "description": "Reduces deep idle behavior on AMD systems for lower latency in gaming sessions on AC power.",
      "applicability": {
        "cpuVendors": [
          "amd"
        ],
        "requiresAdmin": true
      },
      "warning": {
        "level": "warning",
        "title": "Thermal and battery impact possible",
        "why": [
          "Reduces CPU idle residency",
          "May increase idle/package power"
        ],
        "whenToAvoid": [
          "Battery operation",
          "Thin-and-light thermally constrained laptops"
        ],
        "requiresReboot": false,
        "rollbackAvailable": true,
        "badges": [
          "AMD_ONLY",
          "THERMAL_RISK",
          "BATTERY_RISK",
          "LAPTOP_UNSAFE"
        ]
      },
      "badges": [
        "AMD_ONLY",
        "THERMAL_RISK",
        "BATTERY_RISK",
        "LAPTOP_UNSAFE"
      ],
      "apply": {
        "steps": [
          {
            "type": "powercfg.set",
            "args": [
              "/SETACVALUEINDEX",
              "SCHEME_CURRENT",
              "SUB_PROCESSOR",
              "IDLEDISABLE",
              "1"
            ]
          },
          {
            "type": "powercfg.set",
            "args": [
              "/SETACTIVE",
              "SCHEME_CURRENT"
            ]
          }
        ]
      },
      "verify": {
        "steps": [
          {
            "type": "powercfg.set",
            "args": [
              "/QUERY",
              "SCHEME_CURRENT",
              "SUB_PROCESSOR",
              "IDLEDISABLE"
            ]
          }
        ]
      },
      "revert": {
        "steps": [
          {
            "type": "powercfg.set",
            "args": [
              "/SETACVALUEINDEX",
              "SCHEME_CURRENT",
              "SUB_PROCESSOR",
              "IDLEDISABLE",
              "0"
            ]
          },
          {
            "type": "powercfg.set",
            "args": [
              "/SETACTIVE",
              "SCHEME_CURRENT"
            ]
          }
        ]
      }
    },
    {
