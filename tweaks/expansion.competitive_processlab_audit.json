    {
      "id": "timer.stack.launch_dpc_checker_with_stack",
      "type": "action",
      "name": "Timer: Launch DPC Checker With Timer Stack",
      "category": "Timer",
      "description": "Starts the Falcon timer stack (dpclat + SetTimerResolution) and verifies both processes are alive.",
      "riskLevel": "Warning",
      "categoryTier": "Competitive",
      "requiresAdmin": true,
      "requiredTools": [
        "dpclat.exe",
        "SetTimerResolution.exe"
      ],
      "elevationLevel": "admin",
      "apply": {
        "steps": [
          {
            "type": "registry.set",
            "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Kernel",
            "name": "GlobalTimerResolutionRequests",
            "value": 1,
            "valueType": "DWORD",
            "continueOnError": true
          },
          {
            "type": "ps.run",
            "command": "$base = Join-Path (Get-Location) 'tools\\FalconLibrary'; $timerExe = Join-Path $base 'Timer Resolution\\SetTimerResolution.exe'; $dpcExe = Join-Path $base 'DPC Checker\\dpclat.exe'; if(-not (Test-Path -LiteralPath $timerExe)){ throw \"Missing SetTimerResolution.exe at $timerExe\" }; if(-not (Test-Path -LiteralPath $dpcExe)){ throw \"Missing dpclat.exe at $dpcExe\" }; if(-not (Get-Process -Name dpclat -ErrorAction SilentlyContinue)){ Start-Process -FilePath $dpcExe -WindowStyle Minimized }; $resolution = $env:FalconTimerResolutionUs; if([string]::IsNullOrWhiteSpace($resolution)){ $resolution = '5000' }; if(-not (Get-Process -Name SetTimerResolution -ErrorAction SilentlyContinue)){ Start-Process -FilePath $timerExe -ArgumentList @('--resolution', $resolution, '--no-console') -WindowStyle Hidden }; Start-Sleep -Milliseconds 400; if(-not (Get-Process -Name dpclat -ErrorAction SilentlyContinue)){ throw 'dpclat is not running after launch.' }; if(-not (Get-Process -Name SetTimerResolution -ErrorAction SilentlyContinue)){ throw 'SetTimerResolution is not running after launch.' }; Write-Output 'Timer stack launched and verified.'"
          }
        ]
      },
      "revert": {
        "steps": [
          {
            "type": "process.kill",
            "name": "SetTimerResolution",
            "continueOnError": true
          },
          {
            "type": "process.kill",
            "name": "dpclat",
            "continueOnError": true
          }
        ]
      },
      "check": {
        "steps": [
          {
            "type": "ps.run",
            "command": "$dp = Get-Process -Name dpclat -ErrorAction SilentlyContinue; $tm = Get-Process -Name SetTimerResolution -ErrorAction SilentlyContinue; if(-not $dp){ throw 'dpclat.exe is not running.' }; if(-not $tm){ throw 'SetTimerResolution.exe is not running.' }; Write-Output 'Timer stack healthy.'"
          }
        ]
      }
    },
    {
      "id": "audio.restart_engine",
      "type": "action",
      "name": "Audio: Restart Audio Engine",
      "category": "Audio / Competitive",
      "description": "Restarts Windows Audio services (Audiosrv, AudioEndpointBuilder) without disabling core audio stack.",
      "riskLevel": "Warning",
      "categoryTier": "Competitive",
      "requiresAdmin": true,
      "apply": {
        "steps": [
          {
            "type": "ps.run",
            "command": "Restart-Service -Name AudioEndpointBuilder -Force -ErrorAction SilentlyContinue; Restart-Service -Name Audiosrv -Force -ErrorAction SilentlyContinue; $a=Get-Service Audiosrv -ErrorAction SilentlyContinue; $b=Get-Service AudioEndpointBuilder -ErrorAction SilentlyContinue; if($a.Status -ne 'Running' -or $b.Status -ne 'Running'){ throw 'Audio services did not return to Running state.' }; Write-Output 'Audio engine restarted successfully.'"
          }
        ]
      },
      "revert": {
        "steps": []
      },
      "check": {
        "steps": [
          {
            "type": "service.check",
            "name": "Audiosrv",
            "status": "Running",
            "startMode": "Automatic"
          },
          {
            "type": "service.check",
            "name": "AudioEndpointBuilder",
            "status": "Running",
            "startMode": "Automatic"
          }
        ]
      }
    },
