    {
      "id": "storage.preset.competitive_latency",
      "type": "toggle",
      "name": "Storage Preset: Competitive Storage Latency",
      "category": "Storage / Competitive",
      "description": "Bundles competitive storage latency choices: disables SATA link power saving, disables Fast Startup, and normalizes TRIM state.",
      "riskLevel": "Warning",
      "categoryTier": "Competitive",
      "requiresAdmin": true,
      "recommendedFor": [
        "Competitive",
        "Desktop systems"
      ],
      "notRecommendedFor": [
        "Battery-focused laptops"
      ],
      "useCase": "Reduce I/O wake latency",
      "elevationLevel": "admin-verify",
      "apply": {
        "steps": [
          {
            "type": "powercfg",
            "args": [
              "/SETACVALUEINDEX",
              "SCHEME_CURRENT",
              "SUB_DISK",
              "dab60367-53fe-4fbc-825e-521d069d2456",
              "0"
            ]
          },
          {
            "type": "powercfg",
            "args": [
              "/SETACTIVE",
              "SCHEME_CURRENT"
            ]
          },
          {
            "type": "registry.set",
            "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Power",
            "name": "HiberbootEnabled",
            "value": 0,
            "valueType": "DWORD"
          },
          {
            "type": "ps.run",
            "command": "$ntfs = (fsutil behavior query DisableDeleteNotify 2>$null | Select-String 'NTFS').ToString(); if($ntfs -match '=\\s*1'){ fsutil behavior set DisableDeleteNotify NTFS 0 | Out-Null }; Write-Output 'TRIM normalized check complete.'"
          }
        ]
      },
      "revert": {
        "steps": [
          {
            "type": "powercfg",
            "args": [
              "/SETACVALUEINDEX",
              "SCHEME_CURRENT",
              "SUB_DISK",
              "dab60367-53fe-4fbc-825e-521d069d2456",
              "1"
            ]
          },
          {
            "type": "powercfg",
            "args": [
              "/SETACTIVE",
              "SCHEME_CURRENT"
            ]
          },
          {
            "type": "registry.set",
            "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Power",
            "name": "HiberbootEnabled",
            "value": 1,
            "valueType": "DWORD"
          }
        ]
      },
      "check": {
        "steps": [
          {
            "type": "registry.check",
            "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Power",
            "name": "HiberbootEnabled",
            "equals": 0,
            "valueType": "DWORD"
          },
          {
            "type": "ps.run",
            "command": "$ntfs = (fsutil behavior query DisableDeleteNotify 2>$null | Select-String 'NTFS').ToString(); if($ntfs -match '=\\s*0'){ Write-Output 'Enabled' } else { Write-Output 'Not Enabled'; exit 2 }"
          }
        ]
      }
    },
