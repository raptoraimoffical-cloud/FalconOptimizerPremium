    {
      "id": "input.advanced.reset_smooth_mouse_curves",
      "type": "toggle",
      "name": "Input Advanced: Reset Smooth Mouse Curves",
      "category": "Input / Advanced",
      "description": "Resets SmoothMouseXCurve and SmoothMouseYCurve to Windows default curve values. Experimental: mainly useful when old accel packs left non-standard curve data.",
      "riskLevel": "Experimental",
      "categoryTier": "Experimental",
      "requiresAdmin": false,
      "recommendedFor": [
        "Competitive",
        "Users migrating from old accel tweaks"
      ],
      "notRecommendedFor": [
        "Users who intentionally tuned custom mouse curves"
      ],
      "useCase": "Input consistency",
      "elevationLevel": "normal",
      "apply": {
        "steps": [
          {
            "type": "registry.set",
            "path": "HKCU\\Control Panel\\Mouse",
            "name": "SmoothMouseXCurve",
            "value": "00,00,00,00,00,00,00,00,00,00,38,00,00,00,00,00,00,00,70,00,00,00,00,00,00,00,A8,00,00,00,00,00",
            "valueType": "Binary"
          },
          {
            "type": "registry.set",
            "path": "HKCU\\Control Panel\\Mouse",
            "name": "SmoothMouseYCurve",
            "value": "00,00,00,00,00,00,00,00,00,00,38,00,00,00,00,00,00,00,70,00,00,00,00,00,00,00,A8,00,00,00,00,00",
            "valueType": "Binary"
          }
        ]
      },
      "revert": {
        "steps": [
          {
            "type": "registry.remove",
            "path": "HKCU\\Control Panel\\Mouse",
            "name": "SmoothMouseXCurve"
          },
          {
            "type": "registry.remove",
            "path": "HKCU\\Control Panel\\Mouse",
            "name": "SmoothMouseYCurve"
          }
        ]
      },
      "check": {
        "steps": [
          {
            "type": "registry.check",
            "path": "HKCU\\Control Panel\\Mouse",
            "name": "SmoothMouseXCurve",
            "valueType": "Binary",
            "equals": "00,00,00,00,00,00,00,00,00,00,38,00,00,00,00,00,00,00,70,00,00,00,00,00,00,00,A8,00,00,00,00,00"
          },
          {
            "type": "registry.check",
            "path": "HKCU\\Control Panel\\Mouse",
            "name": "SmoothMouseYCurve",
            "valueType": "Binary",
            "equals": "00,00,00,00,00,00,00,00,00,00,38,00,00,00,00,00,00,00,70,00,00,00,00,00,00,00,A8,00,00,00,00,00"
          }
        ]
      }
    },
