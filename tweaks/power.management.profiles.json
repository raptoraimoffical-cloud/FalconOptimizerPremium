            "type": "cmd.run",
            "command": "powercfg /setactive SCHEME_BALANCED"
          }
        ]
      }
    },
    {
      "id": "power_profile_saver_perf_bias_apply",
      "type": "button",
      "name": "Power Saver With Performance Bias",
      "risk": "Safe",
      "riskLevel": "Safe",
      "category": "Power Management",
      "requiresAdmin": true,
      "description": "Best for battery/runtime and lower heat on laptops. Uses DC-friendly CPU and device power-saving behavior and is not recommended for competitive FPS sessions. Snapshot is taken before apply; verify queries run after apply; revert sets Balanced as a safe fallback.",
      "apply": {
        "steps": [
          {
            "type": "ps.run",
            "command": "$ts=Get-Date -Format yyyyMMdd-HHmmss; $dir=Join-Path $PWD 'backups'; if(!(Test-Path $dir)){New-Item -ItemType Directory -Path $dir|Out-Null}; $guid=((powercfg /getactivescheme) -replace '.*GUID:\\s*([0-9a-fA-F-]+).*','$1').Trim(); $out=Join-Path $dir ('profile-pre-'+$ts+'.pow'); powercfg /export $out $guid; Write-Output ('Snapshot: '+$out)"
          },
          {
            "type": "cmd.run",
            "command": "powercfg -setactive SCHEME_BALANCED"
          },
          {
            "type": "cmd.run",
            "command": "powercfg -setdcvalueindex SCHEME_CURRENT SUB_PROCESSOR PROCTHROTTLEMIN 10"
          },
          {
            "type": "cmd.run",
            "command": "powercfg -setdcvalueindex SCHEME_CURRENT SUB_PROCESSOR PROCTHROTTLEMAX 85"
          },
          {
            "type": "cmd.run",
            "command": "powercfg -setdcvalueindex SCHEME_CURRENT SUB_PROCESSOR PERFEPP 65"
          },
          {
            "type": "cmd.run",
            "command": "powercfg -setdcvalueindex SCHEME_CURRENT SUB_USB USBSELECTSUSPEND 1"
          },
          {
            "type": "cmd.run",
            "command": "powercfg -setdcvalueindex SCHEME_CURRENT SUB_VIDEO VIDEOIDLE 5"
          },
          {
            "type": "cmd.run",
            "command": "powercfg -setdcvalueindex SCHEME_CURRENT SUB_SLEEP STANDBYIDLE 15"
          },
          {
            "type": "cmd.run",
            "command": "powercfg /setactive SCHEME_CURRENT"
          }
        ]
      },
      "verify": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "powercfg /query SCHEME_CURRENT SUB_PROCESSOR PROCTHROTTLEMIN"
          },
          {
            "type": "cmd.run",
            "command": "powercfg /query SCHEME_CURRENT SUB_PROCESSOR PROCTHROTTLEMAX"
          },
          {
            "type": "cmd.run",
            "command": "powercfg /query SCHEME_CURRENT SUB_PROCESSOR PERFEPP"
          }
        ]
      },
      "revert": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "powercfg /setactive SCHEME_BALANCED"
          }
        ]
      }
    }
  ]
}