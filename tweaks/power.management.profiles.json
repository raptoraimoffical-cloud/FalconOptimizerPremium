{
  "items": [
    {
      "id": "power_profile_max_performance_apply",
      "type": "button",
      "name": "Max Performance",
      "risk": "Warning",
      "riskLevel": "Warning",
      "category": "Power Management",
      "requiresAdmin": true,
      "description": "Best for desktops and plugged-in laptops chasing max FPS and lowest delay. Disables several AC power-saving behaviors (USB suspend, PCIe ASPM, disk idle) and increases heat/power draw. Snapshot is taken before apply; verify queries run after apply; revert sets Balanced as a safe fallback.",
      "apply": {
        "steps": [
          {
            "type": "ps.run",
            "command": "$ts=Get-Date -Format yyyyMMdd-HHmmss; $dir=Join-Path $PWD 'backups'; if(!(Test-Path $dir)){New-Item -ItemType Directory -Path $dir|Out-Null}; $guid=((powercfg /getactivescheme) -replace '.*GUID:\\s*([0-9a-fA-F-]+).*','$1').Trim(); $out=Join-Path $dir ('profile-pre-'+$ts+'.pow'); powercfg /export $out $guid; Write-Output ('Snapshot: '+$out)"
          },
          {
            "type": "cmd.run",
            "command": "powercfg -setactive SCHEME_MIN"
          },
          {
            "type": "cmd.run",
            "command": "powercfg -setacvalueindex SCHEME_CURRENT SUB_PROCESSOR PROCTHROTTLEMIN 100"
          },
          {
            "type": "cmd.run",
            "command": "powercfg -setacvalueindex SCHEME_CURRENT SUB_PROCESSOR PROCTHROTTLEMAX 100"
          },
          {
            "type": "cmd.run",
            "command": "powercfg -setacvalueindex SCHEME_CURRENT SUB_PROCESSOR PERFBOOSTMODE 2"
          },
          {
            "type": "cmd.run",
            "command": "powercfg -setacvalueindex SCHEME_CURRENT SUB_PROCESSOR CPMINCORES 100"
          },
          {
            "type": "cmd.run",
            "command": "powercfg -setacvalueindex SCHEME_CURRENT SUB_PROCESSOR CPMAXCORES 100"
          },
          {
            "type": "cmd.run",
            "command": "powercfg -setacvalueindex SCHEME_CURRENT SUB_PCIEXPRESS ASPM 0"
          },
          {
            "type": "cmd.run",
            "command": "powercfg -setacvalueindex SCHEME_CURRENT SUB_USB USBSELECTSUSPEND 0"
          },
          {
            "type": "cmd.run",
            "command": "powercfg -setacvalueindex SCHEME_CURRENT SUB_DISK DISKIDLE 0"
          },
          {
            "type": "cmd.run",
            "command": "powercfg -setacvalueindex SCHEME_CURRENT SUB_SLEEP RTCWAKE 1"
          },
          {
            "type": "cmd.run",
            "command": "powercfg /setactive SCHEME_CURRENT"
          }
        ]
      },
      "verify": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "powercfg /query SCHEME_CURRENT SUB_PROCESSOR PROCTHROTTLEMIN"
          },
          {
            "type": "cmd.run",
            "command": "powercfg /query SCHEME_CURRENT SUB_PROCESSOR PROCTHROTTLEMAX"
          },
          {
            "type": "cmd.run",
            "command": "powercfg /query SCHEME_CURRENT SUB_PROCESSOR PERFEPP"
          }
        ]
      },
      "revert": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "powercfg /setactive SCHEME_BALANCED"
          }
        ]
      }
    },
    {
      "id": "power_profile_balanced_perf_apply",
      "type": "button",
      "name": "Balanced Performance",
      "risk": "Safe",
      "riskLevel": "Safe",
      "category": "Power Management",
      "requiresAdmin": true,
      "description": "Good default for most PCs: keeps strong performance while allowing saner idle behavior than Max Performance. Better thermals and power use than max mode. Snapshot is taken before apply; verify queries run after apply; revert sets Balanced as a safe fallback.",
      "apply": {
        "steps": [
          {
            "type": "ps.run",
            "command": "$ts=Get-Date -Format yyyyMMdd-HHmmss; $dir=Join-Path $PWD 'backups'; if(!(Test-Path $dir)){New-Item -ItemType Directory -Path $dir|Out-Null}; $guid=((powercfg /getactivescheme) -replace '.*GUID:\\s*([0-9a-fA-F-]+).*','$1').Trim(); $out=Join-Path $dir ('profile-pre-'+$ts+'.pow'); powercfg /export $out $guid; Write-Output ('Snapshot: '+$out)"
          },
          {
            "type": "cmd.run",
            "command": "powercfg -setactive SCHEME_BALANCED"
          },
          {
            "type": "cmd.run",
            "command": "powercfg -setacvalueindex SCHEME_CURRENT SUB_PROCESSOR PROCTHROTTLEMIN 20"
          },
          {
            "type": "cmd.run",
            "command": "powercfg -setacvalueindex SCHEME_CURRENT SUB_PROCESSOR PROCTHROTTLEMAX 100"
          },
          {
            "type": "cmd.run",
            "command": "powercfg -setacvalueindex SCHEME_CURRENT SUB_PROCESSOR PERFEPP 20"
          },
          {
            "type": "cmd.run",
            "command": "powercfg -setacvalueindex SCHEME_CURRENT SUB_PROCESSOR CPMINCORES 40"
          },
          {
            "type": "cmd.run",
            "command": "powercfg -setacvalueindex SCHEME_CURRENT SUB_PROCESSOR CPMAXCORES 100"
          },
          {
            "type": "cmd.run",
            "command": "powercfg -setacvalueindex SCHEME_CURRENT SUB_USB USBSELECTSUSPEND 0"
          },
          {
            "type": "cmd.run",
            "command": "powercfg -setacvalueindex SCHEME_CURRENT SUB_DISK DISKIDLE 20"
          },
          {
            "type": "cmd.run",
            "command": "powercfg /setactive SCHEME_CURRENT"
          }
        ]
      },
      "verify": {
        "steps": [
