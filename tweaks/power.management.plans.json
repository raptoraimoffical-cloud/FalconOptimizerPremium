{
  "items": [
    {
      "id": "power_plans_list_all",
      "type": "button",
      "name": "Plans: List All + Active",
      "risk": "Safe",
      "riskLevel": "Safe",
      "category": "Power Management",
      "description": "Enumerates all schemes and shows the currently active plan.",
      "apply": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "powercfg /list"
          },
          {
            "type": "cmd.run",
            "command": "powercfg /getactivescheme"
          }
        ]
      }
    },
    {
      "id": "power_plan_snapshot_export",
      "type": "button",
      "name": "Plans: Export Active Plan Snapshot (.pow)",
      "risk": "Safe",
      "riskLevel": "Safe",
      "category": "Power Management",
      "requiresAdmin": true,
      "description": "Creates a timestamped rollback snapshot before batch tuning.",
      "apply": {
        "steps": [
          {
            "type": "ps.run",
            "command": "$ts=Get-Date -Format \"yyyyMMdd-HHmmss\"; $dir=Join-Path $PWD \"backups\"; if(!(Test-Path $dir)){New-Item -ItemType Directory -Path $dir|Out-Null}; $path=Join-Path $dir (\"power-plan-\"+$ts+\".pow\"); $id=((powercfg /getactivescheme) -replace '.*GUID:\\s*([0-9a-fA-F-]+).*','$1').Trim(); powercfg /export $path $id; Write-Output \"Saved snapshot: $path\""
          }
        ]
      }
    },
    {
      "id": "power_plan_clone_active",
      "type": "button",
      "name": "Plans: Clone Current Plan (Safety Copy)",
      "risk": "Safe",
      "riskLevel": "Safe",
      "category": "Power Management",
      "requiresAdmin": true,
      "description": "Duplicates the active scheme before manual or profile-based edits.",
      "apply": {
        "steps": [
          {
            "type": "ps.run",
            "command": "$id=((powercfg /getactivescheme) -replace '.*GUID:\\s*([0-9a-fA-F-]+).*','$1').Trim(); powercfg /duplicatescheme $id"
          }
        ]
      }
    },
    {
      "id": "power_plan_activate_high_perf",
      "type": "button",
      "name": "Plans: Activate High Performance",
      "risk": "Safe",
      "riskLevel": "Safe",
      "category": "Power Management",
      "requiresAdmin": true,
      "description": "Switches to the stock High Performance plan.",
      "apply": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "powercfg /setactive SCHEME_MIN"
          }
        ]
      }
    },
    {
      "id": "power_plan_activate_ultimate",
      "type": "button",
      "name": "Plans: Activate Ultimate Performance (or create)",
      "risk": "Warning",
      "riskLevel": "Warning",
      "category": "Power Management",
      "requiresAdmin": true,
      "description": "Activates Ultimate Performance and attempts to create it when missing.",
      "apply": {
        "steps": [
          {
            "type": "ps.run",
            "command": "$u='e9a42b02-d5df-448d-aa00-03f14749eb61'; $has=(powercfg /list | Select-String $u); if(-not $has){ powercfg /duplicatescheme $u | Out-Null }; powercfg /setactive $u"
          }
        ]
      }
    },
    {
      "id": "power_plan_gaming_ac_only",
      "type": "button",
      "name": "Plans: Apply Gaming AC-Only Baseline",
      "risk": "Warning",
      "riskLevel": "Warning",
      "category": "Power Management",
      "requiresAdmin": true,
      "description": "Writes only AC values for a competitive baseline while leaving DC safety intact.",
      "apply": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "powercfg -setacvalueindex SCHEME_CURRENT SUB_PROCESSOR PROCTHROTTLEMIN 100"
          },
          {
            "type": "cmd.run",
            "command": "powercfg -setacvalueindex SCHEME_CURRENT SUB_PROCESSOR PROCTHROTTLEMAX 100"
          },
          {
            "type": "cmd.run",
            "command": "powercfg -setacvalueindex SCHEME_CURRENT SUB_PCIEXPRESS ASPM 0"
          },
          {
            "type": "cmd.run",
            "command": "powercfg -setacvalueindex SCHEME_CURRENT SUB_USB USBSELECTSUSPEND 0"
          },
          {
            "type": "cmd.run",
            "command": "powercfg /setactive SCHEME_CURRENT"
          }
        ]
      }
    },
    {
      "id": "power_plan_battery_safe_dc",
      "type": "button",
      "name": "Plans: Apply Battery-Safe DC Baseline",
      "risk": "Safe",
      "riskLevel": "Safe",
      "category": "Power Management",
      "requiresAdmin": true,
      "description": "Writes only DC values for safer laptop battery behavior.",
      "apply": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "powercfg -setdcvalueindex SCHEME_CURRENT SUB_PROCESSOR PROCTHROTTLEMIN 5"
          },
          {
            "type": "cmd.run",
            "command": "powercfg -setdcvalueindex SCHEME_CURRENT SUB_PROCESSOR PROCTHROTTLEMAX 85"
          },
          {
            "type": "cmd.run",
            "command": "powercfg -setdcvalueindex SCHEME_CURRENT SUB_USB USBSELECTSUSPEND 1"
          },
          {
            "type": "cmd.run",
            "command": "powercfg -setdcvalueindex SCHEME_CURRENT SUB_VIDEO VIDEOIDLE 5"
          },
          {
            "type": "cmd.run",
            "command": "powercfg /setactive SCHEME_CURRENT"
          }
        ]
      }
    },
    {
      "id": "power_plan_restore_defaults",
      "type": "button",
      "name": "Plans: Restore Windows Default Schemes",
      "risk": "Experimental",
      "riskLevel": "Experimental",
      "category": "Power Management",
      "requiresAdmin": true,
      "description": "Emergency reset for all power schemes; custom plans are removed.",
      "apply": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "powercfg -restoredefaultschemes"
          }
        ]
      }
    },
    {
      "id": "power_plan_import_snapshot",
      "type": "button",
      "name": "Plans: Import .pow Snapshot (C:/FalconPower/restore.pow)",
      "risk": "Warning",
      "riskLevel": "Warning",
      "category": "Power Management",
      "requiresAdmin": true,
      "description": "Imports a previously exported scheme file to restore known-good power behavior.",
      "apply": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "if not exist C:\\FalconPower mkdir C:\\FalconPower"
          },
          {
            "type": "cmd.run",
            "command": "powercfg /import C:\\FalconPower\\restore.pow"
          },
          {
            "type": "cmd.run",
            "command": "powercfg /list"
          }
        ]
      }
    },
    {
      "id": "power_plan_aliases_dump",
      "type": "button",
      "name": "Plans: Dump Aliases + Full Query (verification)",
      "risk": "Safe",
      "riskLevel": "Safe",
      "category": "Power Management",
      "description": "Collects aliases and active scheme values for readback verification.",
      "apply": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "if not exist C:\\FalconPower mkdir C:\\FalconPower"
          },
          {
            "type": "cmd.run",
            "command": "powercfg /aliases > C:\\FalconPower\\aliases.txt"
          },
          {
            "type": "cmd.run",
            "command": "powercfg /query SCHEME_CURRENT > C:\\FalconPower\\query_scheme_current.txt"
          }
        ]
      }
    },
    {
      "id": "power_plan_duplicate_and_name_gaming",
      "type": "button",
      "name": "Plans: Duplicate Active Scheme and Name 'Falcon Gaming AC'",
      "risk": "Safe",
      "riskLevel": "Safe",
      "category": "Power Management",
      "requiresAdmin": true,
      "description": "Creates a dedicated editable clone before experimental writes.",
      "apply": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "for /f \"tokens=3\" %i in ('powercfg /getactivescheme') do powercfg /duplicatescheme %i"
          },
          {
            "type": "cmd.run",
            "command": "for /f \"tokens=3\" %i in ('powercfg /list ^| findstr /i \"*\"') do powercfg /changename %i \"Falcon Gaming AC\""
          },
          {
            "type": "cmd.run",
            "command": "powercfg /list"
          }
        ]
      }
    },
    {
      "id": "power_plan_activate_balanced",
      "type": "button",
      "name": "Plans: Activate Balanced Plan",
      "risk": "Safe",
      "riskLevel": "Safe",
      "category": "Power Management",
      "requiresAdmin": true,
      "description": "Switches to Balanced if available.",
      "apply": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "powercfg /setactive SCHEME_BALANCED"
          }
        ]
      }
    },
    {
      "id": "power_plan_export_before_extreme",
      "type": "button",
      "name": "Plans: Export Active Plan Before Extreme Tweaks",
      "risk": "Safe",
      "riskLevel": "Safe",
      "category": "Power Management",
      "description": "Creates rollback .pow snapshot with timestamp.",
      "apply": {
        "steps": [
          {
            "type": "ps.run",
            "command": "$ts=Get-Date -Format yyyyMMdd-HHmmss; $dir=Join-Path $PWD \"backups\"; if(!(Test-Path $dir)){New-Item -ItemType Directory -Path $dir|Out-Null}; $guid=(powercfg /getactivescheme).ToString().Split()[3]; $out=Join-Path $dir (\"active-plan-pre-extreme-\"+$ts+\".pow\"); powercfg /export $out $guid; Write-Output \"Saved: $out\""
          }
        ]
      }
    },
    {
      "id": "power_plan_diff_current_vs_last_snapshot",
      "type": "button",
      "name": "Plans: Diff Current /QH vs Most Recent Snapshot",
      "risk": "Safe",
      "riskLevel": "Safe",
      "category": "Power Management",
      "description": "Exports current /qh output and compares with the newest snapshot text if present.",
      "apply": {
        "steps": [
          {
            "type": "ps.run",
            "command": "$dir=Join-Path $PWD \"logs\"; if(!(Test-Path $dir)){New-Item -ItemType Directory -Path $dir|Out-Null}; $ts=Get-Date -Format yyyyMMdd-HHmmss; $cur=Join-Path $dir (\"powercfg-qh-current-\"+$ts+\".txt\"); powercfg /qh SCHEME_CURRENT > $cur; $prev=Get-ChildItem $dir -Filter \"powercfg-qh-current-*.txt\" | Sort-Object LastWriteTime -Descending | Select-Object -Skip 1 -First 1; if($prev){ Compare-Object (Get-Content $prev.FullName) (Get-Content $cur) -SyncWindow 2 | Out-String | Write-Output } else { Write-Output \"No previous snapshot found for diff.\" }"
          }
        ]
      }
    }
  ]
}
