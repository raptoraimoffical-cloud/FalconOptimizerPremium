{
  "items": [
    {
      "id": "power_plan_list_all",
      "type": "button",
      "name": "List All Power Plans",
      "risk": "Safe",
      "riskLevel": "Safe",
      "category": "Power Management",
      "description": "Enumerates all schemes with GUIDs for management and diff workflows.",
      "apply": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "powercfg /list"
          },
          {
            "type": "cmd.run",
            "command": "powercfg /getactivescheme"
          }
        ]
      }
    },
    {
      "id": "power_plan_set_ultimate",
      "type": "button",
      "name": "Set Active Plan: Ultimate Performance",
      "risk": "Warning",
      "riskLevel": "Warning",
      "category": "Power Management",
      "requiresAdmin": true,
      "description": "Creates Ultimate Performance if needed and activates it.",
      "apply": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "powercfg -duplicatescheme e9a42b02-d5df-448d-aa00-03f14749eb61 >nul 2>&1"
          },
          {
            "type": "cmd.run",
            "command": "powercfg /setactive e9a42b02-d5df-448d-aa00-03f14749eb61"
          },
          {
            "type": "cmd.run",
            "command": "powercfg /getactivescheme"
          }
        ]
      },
      "revert": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "powercfg /setactive SCHEME_BALANCED"
          }
        ]
      }
    },
    {
      "id": "power_plan_clone_current",
      "type": "button",
      "name": "Clone Current Plan (snapshot-ready)",
      "risk": "Safe",
      "riskLevel": "Safe",
      "category": "Power Management",
      "requiresAdmin": true,
      "description": "Duplicates the active scheme so aggressive edits can be isolated to a clone.",
      "apply": {
        "steps": [
          {
            "type": "ps.run",
            "command": "$active=(powercfg /getactivescheme | Out-String); if($active -match \"([0-9a-fA-F-]{36})\"){ $guid=$Matches[1]; powercfg /duplicatescheme $guid | Write-Output } else { throw \"Could not parse active scheme GUID.\" }"
          }
        ]
      }
    }
  ]
}
