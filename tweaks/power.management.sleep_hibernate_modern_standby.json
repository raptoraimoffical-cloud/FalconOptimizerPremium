            "type": "cmd.run",
            "command": "powercfg -setdcvalueindex SCHEME_CURRENT SUB_SLEEP UNATTENDIDLE 10"
          },
          {
            "type": "cmd.run",
            "command": "powercfg /setactive SCHEME_CURRENT"
          }
        ]
      }
    },
    {
      "id": "power_sleep_away_mode_disable",
      "type": "button",
      "name": "Sleep: Disable Away Mode",
      "risk": "Warning",
      "riskLevel": "Warning",
      "category": "Power Management",
      "requiresAdmin": true,
      "description": "Turns off away mode to avoid pseudo-sleep behavior on gaming rigs.",
      "apply": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "powercfg -setacvalueindex SCHEME_CURRENT SUB_SLEEP AWAYMODE 0"
          },
          {
            "type": "cmd.run",
            "command": "powercfg -setdcvalueindex SCHEME_CURRENT SUB_SLEEP AWAYMODE 0"
          },
          {
            "type": "cmd.run",
            "command": "powercfg /setactive SCHEME_CURRENT"
          }
        ]
      }
    },
    {
      "id": "power_hibernate_type_reduced",
      "type": "button",
      "name": "Hibernate: Set Reduced Type (Fast Startup-oriented)",
      "risk": "Warning",
      "riskLevel": "Warning",
      "category": "Power Management",
      "requiresAdmin": true,
      "description": "Switches hiberfile to reduced mode where supported.",
      "apply": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "powercfg /hibernate on"
          },
          {
            "type": "cmd.run",
            "command": "powercfg /hibernate /type reduced"
          }
        ]
      },
      "revert": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "powercfg /hibernate /type full"
          }
        ]
      }
    },
    {
      "id": "power_sleep_modern_standby_diagnostics",
      "type": "button",
      "name": "Modern Standby: Capability + SleepStudy Diagnostics",
      "risk": "Safe",
      "riskLevel": "Safe",
      "category": "Power Management",
      "description": "Runs supported sleep-state listing and SleepStudy report generation.",
      "apply": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "powercfg /a"
          },
          {
            "type": "cmd.run",
            "command": "powercfg /sleepstudy"
          }
        ]
      }
    },
    {
