    {
      "id": "power_sleep_password_on_wake_enable",
      "type": "button",
      "name": "Sleep: Require Password on Wake",
      "risk": "Safe",
      "riskLevel": "Safe",
      "category": "Power Management",
      "requiresAdmin": true,
      "description": "Enforces sign-in after wake on AC/DC.",
      "apply": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "powercfg /SETACVALUEINDEX SCHEME_CURRENT SUB_NONE CONSOLELOCK 1"
