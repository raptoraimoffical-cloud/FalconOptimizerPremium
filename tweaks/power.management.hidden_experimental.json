{
  "items": [
    {
      "id": "power_hidden_unattended_sleep_timeout",
      "type": "button",
      "name": "Hidden: System Unattended Sleep Timeout (AC 0 / DC 15)",
      "risk": "Experimental",
      "riskLevel": "Experimental",
      "category": "Power Management",
      "requiresAdmin": true,
      "description": "Applies hidden unattended sleep timeout values (conditional support by platform/build).",
      "apply": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "powercfg -setacvalueindex SCHEME_CURRENT SUB_SLEEP UNATTENDIDLE 0"
          },
          {
            "type": "cmd.run",
            "command": "powercfg -setdcvalueindex SCHEME_CURRENT SUB_SLEEP UNATTENDIDLE 15"
          },
          {
            "type": "cmd.run",
            "command": "powercfg /setactive SCHEME_CURRENT"
          }
        ]
      }
    },
    {
      "id": "power_hidden_restore_defaults_warning",
      "type": "button",
      "name": "Emergency: Restore Default Schemes",
      "risk": "Experimental",
      "riskLevel": "Experimental",
      "category": "Power Management",
      "requiresAdmin": true,
      "description": "Resets all Windows power schemes to defaults. Use only as last resort after exports/snapshots.",
      "apply": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "powercfg -restoredefaultschemes"
          },
          {
            "type": "cmd.run",
            "command": "powercfg /list"
          }
        ]
      }
    },
    {
      "id": "power_hidden_processor_response_pack",
      "type": "button",
      "name": "Hidden: Processor Responsiveness Pack (Thresholds + Time Checks)",
      "risk": "Experimental",
      "riskLevel": "Experimental",
      "category": "Power Management",
      "requiresAdmin": true,
      "description": "Writes advanced hidden PPM responsiveness knobs intended for competitive AC testing.",
      "apply": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "powercfg -setacvalueindex SCHEME_CURRENT SUB_PROCESSOR PERFINCTHRESHOLD 20"
          },
          {
            "type": "cmd.run",
            "command": "powercfg -setacvalueindex SCHEME_CURRENT SUB_PROCESSOR PERFDECTHRESHOLD 65"
          },
          {
            "type": "cmd.run",
            "command": "powercfg -setacvalueindex SCHEME_CURRENT SUB_PROCESSOR PERFTIMECHECK 15"
          },
          {
            "type": "cmd.run",
            "command": "powercfg /setactive SCHEME_CURRENT"
          }
        ]
      }
    },
    {
      "id": "power_hidden_sleepstudy_systempowerreport",
      "type": "button",
      "name": "Hidden: Generate SleepStudy + SystemPowerReport Bundle",
      "risk": "Safe",
      "riskLevel": "Safe",
      "category": "Power Management",
      "description": "Creates deep diagnostics reports for Modern Standby and wake behavior.",
      "apply": {
        "steps": [
          {
            "type": "ps.run",
            "command": "$dir=Join-Path $PWD 'logs'; if(!(Test-Path $dir)){New-Item -ItemType Directory -Path $dir|Out-Null}; powercfg /sleepstudy /output (Join-Path $dir 'sleepstudy.html'); powercfg /systempowerreport /output (Join-Path $dir 'systempowerreport.html'); Write-Output ('Saved reports to '+$dir)"
          }
        ]
      }
    }
  ]
}