{
  "items": [
    {
      "id": "power_cpu_boost_mode_aggressive",
      "type": "button",
      "name": "Processor: Boost Mode Aggressive (AC) / Efficient (DC)",
      "risk": "Warning",
      "riskLevel": "Warning",
      "category": "Power Management",
      "requiresAdmin": true,
      "description": "Sets boost policy for fast ramp on AC and milder behavior on battery.",
      "apply": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "powercfg -setacvalueindex SCHEME_CURRENT SUB_PROCESSOR PERFBOOSTMODE 2"
          },
          {
            "type": "cmd.run",
            "command": "powercfg -setdcvalueindex SCHEME_CURRENT SUB_PROCESSOR PERFBOOSTMODE 1"
          },
          {
            "type": "cmd.run",
            "command": "powercfg /setactive SCHEME_CURRENT"
          }
        ]
      }
    },
    {
      "id": "power_cpu_epp_split",
      "type": "button",
      "name": "Processor: EPP 0 (AC) / 60 (DC)",
      "risk": "Safe",
      "riskLevel": "Safe",
      "category": "Power Management",
      "requiresAdmin": true,
      "description": "Exposes separate Energy Performance Preference indexes for AC/DC.",
      "apply": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "powercfg -setacvalueindex SCHEME_CURRENT SUB_PROCESSOR PERFEPP 0"
