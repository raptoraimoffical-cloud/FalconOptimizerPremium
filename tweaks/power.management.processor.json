          }
        ]
      }
    },
    {
      "id": "power_cpu_core_parking_minmax",
      "type": "button",
      "name": "Core Parking Min/Max Cores (AC 100/100, DC 30/100)",
      "risk": "Experimental",
      "riskLevel": "Experimental",
      "category": "Power Management",
      "requiresAdmin": true,
      "description": "Uses hidden core parking controls where available for latency-sensitive loads.",
      "apply": {
        "steps": [
          {
            "type": "cmd.run",
