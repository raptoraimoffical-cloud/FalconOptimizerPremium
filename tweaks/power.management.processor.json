    {
      "id": "power_cpu_throttling_disable",
      "type": "button",
      "name": "Power Throttling: Disable (Registry)",
      "risk": "Warning",
      "riskLevel": "Warning",
      "category": "Power Management",
      "requiresAdmin": true,
      "description": "Disables Windows power throttling policy for foreground consistency.",
      "apply": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "reg add \"HKLM\\SYSTEM\\CurrentControlSet\\Control\\Power\\PowerThrottling\" /v PowerThrottlingOff /t REG_DWORD /d 1 /f"
          }
        ]
      },
      "revert": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "reg add \"HKLM\\SYSTEM\\CurrentControlSet\\Control\\Power\\PowerThrottling\" /v PowerThrottlingOff /t REG_DWORD /d 0 /f"
          }
        ]
      }
    }
