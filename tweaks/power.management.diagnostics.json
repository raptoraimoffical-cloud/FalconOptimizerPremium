{
  "items": [
    {
      "id": "power_diag_supported_sleep_states",
      "type": "button",
      "name": "Diagnostics: List Supported Sleep States",
      "risk": "Safe",
      "riskLevel": "Safe",
      "category": "Power Management",
      "description": "Shows S-states and Modern Standby capabilities.",
      "apply": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "powercfg /a"
          }
        ]
      }
    },
    {
      "id": "power_diag_wake_timers_lastwake",
      "type": "button",
      "name": "Diagnostics: Wake Timers + Last Wake",
      "risk": "Safe",
      "riskLevel": "Safe",
      "category": "Power Management",
      "description": "Reports currently scheduled wake timers and the last wake source.",
      "apply": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "powercfg /waketimers"
          },
          {
            "type": "cmd.run",
            "command": "powercfg /lastwake"
          }
        ]
      }
    },
    {
      "id": "power_diag_requests",
      "type": "button",
      "name": "Diagnostics: Power Requests",
      "risk": "Safe",
      "riskLevel": "Safe",
      "category": "Power Management",
      "description": "Lists active process, driver, and display power requests.",
      "apply": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "powercfg /requests"
          }
        ]
      }
    },
    {
      "id": "power_diag_reports_energy_sleepstudy",
      "type": "button",
      "name": "Diagnostics: Generate Energy + SleepStudy + SystemPowerReport",
      "risk": "Safe",
      "riskLevel": "Safe",
      "category": "Power Management",
      "description": "Generates official power diagnostic reports in the working directory.",
      "apply": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "powercfg /energy"
          },
          {
            "type": "cmd.run",
            "command": "powercfg /sleepstudy"
          },
          {
            "type": "cmd.run",
            "command": "powercfg /systempowerreport"
          }
        ]
      }
    },
    {
      "id": "power_diag_systempowerreport_only",
      "type": "button",
      "name": "Diagnostics: Generate System Power Report",
      "risk": "Safe",
      "riskLevel": "Safe",
      "category": "Power Management",
      "description": "Generates standalone system power report HTML.",
      "apply": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "powercfg /systempowerreport"
          }
        ]
      }
    },
    {
      "id": "power_diag_sleepstudy_only",
      "type": "button",
      "name": "Diagnostics: Generate Sleep Study Report",
      "risk": "Safe",
      "riskLevel": "Safe",
      "category": "Power Management",
      "description": "Generates standalone sleep study report when platform supports it.",
      "apply": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "powercfg /sleepstudy"
          }
        ]
      }
    },
    {
      "id": "power_diag_wakeup_audit_bundle",
      "type": "button",
      "name": "Diagnostics: Wake Audit Bundle (lastwake + waketimers + wake_armed)",
      "risk": "Safe",
      "riskLevel": "Safe",
      "category": "Power Management",
      "description": "Runs key wake-analysis commands in one pass for troubleshooting.",
      "apply": {
        "steps": [
          {
            "type": "cmd.run",
            "command": "powercfg /lastwake"
          },
          {
            "type": "cmd.run",
            "command": "powercfg /waketimers"
          },
          {
            "type": "cmd.run",
            "command": "powercfg /devicequery wake_armed"
          }
        ]
      }
    }
  ]
}
